# Every value is required. The process refuses to start if one is missing.
PORT=8080
DATA_DIR=/data
VAULT_DIR=/vault
JOURNAL_DIR=/journal
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
EVENT_INTAKE_SECRET=
GROQ_API_KEY=
LINEAR_API_KEY=

# Optional. Where grammY sends Bot API calls. Leave it out to use Telegram itself.
# TELEGRAM_API_ROOT=https://api.telegram.org

# Compose only. Host paths of the vault and journal repos.
VAULT_REPO=
JOURNAL_REPO=
